# Optional Hugging Face access token for higher rate limits and faster model downloads.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional split cache roots for learned-IQA assets. --model-cache-dir supplies
# these defaults under one root; explicit values here take precedence.
# HF_HOME=
# HF_HUB_CACHE=
# TORCH_HOME=

# For a fresh-process offline validation, set both flags before starting Python.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Optional startup automation for the packaged learned-IQA/CUDA sidecars.
# Without these settings, ordinary noninteractive launches do not download AI
# runtime packages; model weights remain a separate first-use preparation step.
# SHOTSIEVE_BOOTSTRAP_AUTO_INSTALL_TORCH=1
# SHOTSIEVE_BOOTSTRAP_AUTO_INSTALL_LEARNED_IQA=1
# Set either value to 0 to decline that automatic startup step.
